#!/bin/sh

scenario=${FAKE_KUBECTL_SCENARIO:?}
log=${FAKE_KUBECTL_LOG:?}

case "$1" in
  get)
    case "$scenario" in
      absent)
        exit 0
        ;;
      present)
        case "$*" in
          *resource-policy*) printf '%s||keep' "$3" ;;
          *) printf '%s|' "$3" ;;
        esac
        ;;
      annotate-noop)
        case "$*" in
          *resource-policy*) printf '%s||' "$3" ;;
          *) printf '%s|' "$3" ;;
        esac
        ;;
      terminating)
        printf '%s|2026-08-02T03:00:00Z' "$3"
        ;;
      get-error)
        echo "forced kubectl get failure" >&2
        exit 7
        ;;
    esac
    ;;
  annotate)
    if [ "$scenario" = "absent" ]; then
      echo "unexpected annotate for absent ComponentDefinition" >&2
      exit 9
    fi
    printf '%s\n' "$*" >>"$log"
    ;;
  *)
    echo "unexpected kubectl command: $*" >&2
    exit 8
    ;;
esac
