{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "serviceVersion",
    "versions",
    "volumeSizeLimitMB"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "registry",
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "enum": [
            "4.47",
            "4.48"
          ]
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "serviceVersion": {
      "type": "string",
      "enum": [
        "4.47.0",
        "4.48.0"
      ]
    },
    "versions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "version",
          "tag"
        ],
        "properties": {
          "version": {
            "type": "string",
            "enum": [
              "4.47.0",
              "4.48.0"
            ]
          },
          "tag": {
            "type": "string",
            "enum": [
              "4.47",
              "4.48"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "volumeSizeLimitMB": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    }
  }
}
