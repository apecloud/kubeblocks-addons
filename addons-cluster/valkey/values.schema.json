{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "allOf": [
    {
      "not": {
        "properties": {
          "nodePortEnabled": {
            "const": true
          },
          "loadBalancerEnabled": {
            "const": true
          }
        },
        "required": [
          "nodePortEnabled",
          "loadBalancerEnabled"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "replication"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "replicas": {
            "minimum": 2
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "customSecretName": {
              "const": ""
            },
            "customSecretNamespace": {
              "const": ""
            }
          },
          "required": [
            "customSecretName",
            "customSecretNamespace"
          ]
        },
        {
          "properties": {
            "customSecretName": {
              "minLength": 1
            },
            "customSecretNamespace": {
              "minLength": 1
            }
          },
          "required": [
            "customSecretName",
            "customSecretNamespace"
          ]
        }
      ]
    }
  ],
  "properties": {
    "version": {
      "title": "Version",
      "description": "Valkey service version.",
      "type": "string",
      "default": "9.0.0"
    },
    "mode": {
      "title": "Mode",
      "description": "Valkey topology mode.",
      "type": "string",
      "default": "replication",
      "enum": [
        "standalone",
        "replication",
        "cluster"
      ]
    },
    "replicas": {
      "title": "Replicas",
      "description": "The number of data component replicas.",
      "type": "integer",
      "default": 3,
      "minimum": 1,
      "maximum": 5
    },
    "cpu": {
      "title": "CPU",
      "description": "CPU quantity (for example 500m or 1).",
      "type": [
        "number",
        "string"
      ],
      "default": "500m",
      "anyOf": [
        {
          "type": "number",
          "minimum": 0.1,
          "maximum": 64
        },
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(m)?$"
        }
      ]
    },
    "memory": {
      "title": "Memory",
      "description": "Kubernetes memory quantity; legacy numeric values are interpreted as Gi.",
      "type": [
        "number",
        "string"
      ],
      "default": "512Mi",
      "anyOf": [
        {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1000
        },
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMK]i?)$"
        }
      ]
    },
    "storage": {
      "title": "Storage",
      "description": "Kubernetes storage quantity; legacy numeric values are interpreted as Gi.",
      "type": [
        "number",
        "string"
      ],
      "default": "20Gi",
      "anyOf": [
        {
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMK]i?)$"
        }
      ]
    },
    "storageClassName": {
      "title": "Storage Class Name",
      "description": "StorageClass name for the data volume.",
      "type": "string",
      "default": ""
    },
    "nodePortEnabled": {
      "title": "NodePort Enabled",
      "type": "boolean",
      "default": false
    },
    "loadBalancerEnabled": {
      "title": "LoadBalancer Enabled",
      "type": "boolean",
      "default": false
    },
    "podAntiAffinityEnabled": {
      "title": "Pod Anti-Affinity Enabled",
      "type": "boolean",
      "default": false
    },
    "tlsEnable": {
      "title": "TLS Enabled",
      "type": "boolean",
      "default": false
    },
    "customSecretName": {
      "title": "Default account secret name",
      "type": "string",
      "default": ""
    },
    "customSecretNamespace": {
      "title": "Default account secret namespace",
      "type": "string",
      "default": ""
    },
    "sentinel": {
      "title": "Valkey Sentinel component",
      "type": "object",
      "properties": {
        "replicas": {
          "title": "Sentinel replicas",
          "type": "integer",
          "default": 3,
          "minimum": 3,
          "maximum": 5
        },
        "cpu": {
          "title": "Sentinel CPU",
          "type": [
            "number",
            "string"
          ],
          "default": "500m",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.1,
              "maximum": 64
            },
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m)?$"
            }
          ]
        },
        "memory": {
          "title": "Sentinel memory",
          "type": [
            "number",
            "string"
          ],
          "default": "512Mi",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1000
            },
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMK]i?)$"
            }
          ]
        },
        "storage": {
          "title": "Sentinel storage",
          "type": [
            "number",
            "string"
          ],
          "default": "5Gi",
          "anyOf": [
            {
              "type": "number",
              "minimum": 1,
              "maximum": 10000
            },
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMK]i?)$"
            }
          ]
        },
        "storageClassName": {
          "title": "Sentinel StorageClass name",
          "type": "string",
          "default": ""
        },
        "customSecretName": {
          "title": "Sentinel default account secret name",
          "type": "string",
          "default": ""
        },
        "customSecretNamespace": {
          "title": "Sentinel default account secret namespace",
          "type": "string",
          "default": ""
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "customSecretName": {
                  "const": ""
                },
                "customSecretNamespace": {
                  "const": ""
                }
              },
              "required": [
                "customSecretName",
                "customSecretNamespace"
              ]
            },
            {
              "properties": {
                "customSecretName": {
                  "minLength": 1
                },
                "customSecretNamespace": {
                  "minLength": 1
                }
              },
              "required": [
                "customSecretName",
                "customSecretNamespace"
              ]
            }
          ]
        }
      ]
    },
    "cluster": {
      "title": "Cluster (sharding) mode",
      "type": "object",
      "properties": {
        "shards": {
          "title": "Shards",
          "type": "integer",
          "default": 3,
          "minimum": 3,
          "maximum": 32
        },
        "replicas": {
          "title": "Replicas per shard",
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 5
        }
      }
    }
  }
}
