{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "topology",
    "serviceVersion",
    "master",
    "volume",
    "filer",
    "s3",
    "admin"
  ],
  "properties": {
    "topology": {
      "enum": [
        "standalone",
        "distributed"
      ]
    },
    "serviceVersion": {
      "type": "string",
      "enum": [
        "4.47.0"
      ]
    },
    "storageClassName": {
      "type": "string"
    },
    "extra": {
      "type": "object",
      "properties": {
        "terminationPolicy": {
          "enum": [
            "DoNotTerminate",
            "Delete",
            "WipeOut"
          ]
        }
      }
    },
    "master": {
      "type": "object",
      "required": [
        "resources",
        "storage"
      ],
      "properties": {
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "storage": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        }
      }
    },
    "volume": {
      "type": "object",
      "required": [
        "resources",
        "storage",
        "replicas"
      ],
      "properties": {
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "storage": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        }
      }
    },
    "filer": {
      "type": "object",
      "required": [
        "resources",
        "storage"
      ],
      "properties": {
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "storage": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        }
      }
    },
    "s3": {
      "type": "object",
      "required": [
        "resources",
        "replicas"
      ],
      "properties": {
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "admin": {
      "type": "object",
      "required": [
        "resources",
        "storage"
      ],
      "properties": {
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "storage": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        }
      }
    }
  }
}
